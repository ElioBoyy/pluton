---
import Base from "../layouts/Base.astro";
import { Glass, LinkButton, Logo } from "@pluton/glass";
import { pathFor, strings, type Locale } from "../i18n/index.ts";
import { PICTURE_CREDITS } from "../credits.ts";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = strings(locale);
---
<Base locale={locale} t={{ ...t, meta: { ...t.meta, title: `${t.footer.creditsLink} · Pluton` } }}>
  <div class="wall" aria-hidden="true">
    <img class="wall-day" src="/img/wall-day.webp" width="1920" height="1080" alt="" />
    <img class="wall-night" src="/img/wall-night.webp" width="1920" height="1080" alt="" />
  </div>
  <main class="credits-page">
    <Glass weight="thick" className="credits-sheet">
      <a class="credits-logo" href={pathFor(locale)}><Logo /></a>
      <h1 class="headline">{t.footer.creditsLink}</h1>
      <ul class="credits-list">
        {PICTURE_CREDITS.map((c) => (
          <li><a href={c.page}>“{c.title}”</a>, {c.creator}, <a href={c.licenseUrl}>{c.license}</a></li>
        ))}
      </ul>
      <LinkButton variant="accent" href={pathFor(locale)}>{t.footer.creditsBack}</LinkButton>
    </Glass>
  </main>
</Base>
