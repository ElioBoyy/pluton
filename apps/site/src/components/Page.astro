---
import Base from "../layouts/Base.astro";
import Logo from "./Logo.astro";
import { LOCALES, LOCALE_NAMES, pathFor, strings, type Locale } from "../i18n/index.ts";
import { SAMPLE_MESSAGES } from "../i18n/messages.ts";
import { SIGNUP_URL, REPO_URL, LICENSE_URL } from "../links.ts";
import credits from "../../assets/credits.json";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = strings(locale);

// The sample market: sixty companies scattered over the plate, five of which move between Monday and Thursday.
// Seeded so every build draws the same sky.
let seed = 1930;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const clear = (x: number, y: number) => !(x < 46 && y < 38) && !(x > 52 && y > 58);
const moverSpots = [
  { x: 14, y: 52, dx: 4.5, dy: -3 },
  { x: 33, y: 74, dx: -3.5, dy: -4 },
  { x: 58, y: 18, dx: 5, dy: 3.5 },
  { x: 78, y: 40, dx: -4, dy: 4 },
  { x: 49, y: 47, dx: 3.5, dy: 4.5 },
];
// Keep every star off the movers and off their labels, on both days.
const nearMover = (x: number, y: number) =>
  moverSpots.some((m) => [[m.x, m.y], [m.x + m.dx, m.y + m.dy]].some(([px, py]) => {
    const labelLeft = px > 55 ? px - 17 : px - 2;
    return x > labelLeft && x < labelLeft + 19 && Math.abs(y - py) < 6.5;
  }));
const stars: { x: number; y: number; r: number }[] = [];
while (stars.length < 55) {
  const x = 3 + rand() * 94, y = 6 + rand() * 88;
  if (clear(x, y) && !nearMover(x, y)) stars.push({ x, y, r: rand() < 0.15 ? 2 : rand() < 0.5 ? 1.4 : 1 });
}
const movers = t.blink.movers.map(([name, signal, source, fit], i) => ({ name, signal, source, fit, ...moverSpots[i] }));

const channels = ["linkedin", "email"] as const;
const swatches = [
  { href: "#how", label: t.nav.how, ground: "print" },
  { href: "#blink", label: t.nav.blink, ground: "blue" },
  { href: "#messages", label: t.nav.messages, ground: "plate" },
  { href: "#pricing", label: t.nav.pricing, ground: "print" },
  { href: "#faq", label: t.nav.faq, ground: "plate-2" },
];
const usedPictures = new Set([
  "assets/pluto-discovery-plates.png",
  "assets/zeiss-blink-comparator-at-lowell-observatory-used.jpg",
  "assets/clyde-tombaugh-records-flickr-brewbooks.jpg",
  "assets/abbot-l-lowell-astrograph-flickr-brewbooks-2.jpg",
  "assets/pluto-01-stern-03-pluto-color-txt.jpg",
]);
const pictureCredits = (credits as { file: string; title: string; creator: string; license: string; licenseUrl: string; page: string }[])
  .filter((c) => usedPictures.has(c.file));
const longestHeroLine = Math.max(...t.hero.lines.map((l) => l.length));
---
<Base locale={locale} t={t}>
  <header class="bar" data-ground="print" aria-label="Pluton">
    <a class="bar-logo" href="#top"><Logo /></a>
    <nav class="bar-nav" aria-label={t.nav.how}>
      {swatches.map((s) => <a href={s.href} data-chapter={s.href.slice(1)}>{s.label}</a>)}
    </nav>
    <a class="btn btn-blue bar-start" href={SIGNUP_URL}>{t.nav.start}</a>
  </header>

  <main>
    <section class="hero" id="top" data-ground="print">
      <div class="hero-panel">
        <div class="plates" role="img" aria-label={`${t.hero.caption} ${t.hero.plateA}, ${t.hero.plateB}.`}>
          <div class="plates-stage">
            <img class="plate plate-a" src="/img/plate-a.webp" width="760" height="760" alt="" fetchpriority="high" />
            <img class="plate plate-b" src="/img/plate-b.webp" width="760" height="760" alt="" />
            <span class="pluto-ring pluto-a"></span>
            <span class="pluto-ring pluto-b"></span>
          </div>
        </div>
        <a class="hero-logo" href={pathFor(locale)}><Logo /></a>
        <nav class="langs" aria-label={t.nav.language}>
          {LOCALES.map((l) => (
            <a href={pathFor(l)} hreflang={l} lang={l} aria-current={l === locale ? "page" : undefined} title={LOCALE_NAMES[l]}>{l.toUpperCase()}</a>
          ))}
        </nav>
        <h1 class="hero-title" style={`--chars:${longestHeroLine}`}>
          {t.hero.lines.map((line) => <span class="line"><span>{line}</span></span>)}
        </h1>
        <p class="hero-sub">{t.hero.sub}</p>
        <a class="btn btn-paper hero-cta" href={SIGNUP_URL}>{t.hero.cta}</a>
        <div class="hero-meta">
          <p class="plate-date"><span class="date-a">{t.hero.plateA}</span><span class="date-b">{t.hero.plateB}</span></p>
          <button class="blink-pause" type="button" aria-pressed="false" data-play={t.hero.play} data-pause={t.hero.pause}>{t.hero.pause}</button>
        </div>
      </div>
      <nav class="swatches" aria-label={t.nav.how}>
        {swatches.map((s) => <a href={s.href} class={`swatch g-${s.ground}`} data-chapter={s.href.slice(1)}>{s.label}</a>)}
      </nav>
    </section>

    <section class="intro g-plate" id="intro" data-ground="plate">
      <h2 class="h-head intro-heading reveal" style={`--chars:${Math.max(...t.intro.heading.map((l) => l.length))}`}>{t.intro.heading.map((l) => <span>{l}</span>)}</h2>
      <p class="stair reveal">
        {[`${t.intro.lines[0]} ${t.intro.lines[1]}`, t.intro.lines[2], `${t.intro.lines[3]} ${t.intro.lines[4]}`].map((line, i) => (
          <span class="stair-line" style={`--i:${i}`}>{line}</span>
        ))}
      </p>
      <div class="intro-photos">
        <figure class="reveal">
          <img src="/img/blink-comparator.webp" width="1600" height="1195" alt={t.intro.photoA} loading="lazy" />
          <figcaption>{t.intro.photoA}</figcaption>
        </figure>
        <figure class="reveal">
          <img src="/img/tombaugh-logbook.webp" width="1600" height="1200" alt={t.intro.photoB} loading="lazy" />
          <figcaption>{t.intro.photoB}</figcaption>
        </figure>
      </div>
      <p class="intro-note reveal">{t.intro.note}</p>
    </section>

    <section class="how" id="how" data-ground="print" aria-labelledby="how-heading">
      <h2 id="how-heading" class="sr-only">{t.how.heading}</h2>
      <div class="how-words g-print">
        {t.how.stages.map((s, i) => (
          <div class="how-stage" data-stage={i} aria-hidden={i === 0 ? undefined : "true"}>
            <h3 class="h-head">{s.clause}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
      <div class="how-ui g-plate-2">
        <div class="frag frag-brain" data-ui data-stage="0">
          <p class="frag-title"><Logo symbolOnly /> {t.how.brain.title} <strong>{t.how.brain.company}</strong></p>
          <dl>
            {t.how.brain.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </div>
        <div class="frag frag-play" data-ui data-stage="1" aria-hidden="true">
          <p class="frag-title">{t.how.play.title}</p>
          <dl>
            {t.how.play.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <span class="frag-button">{t.how.play.action}</span>
        </div>
        <div class="frag frag-leads" data-ui data-stage="2" aria-hidden="true">
          <p class="frag-title">{t.how.leads.title}</p>
          <ol>
            {t.how.leads.rows.map(([name, role, signal, fit], i) => (
              <li class={i === 0 ? "is-focus" : undefined}>
                <span class="fit" aria-label={`${t.how.leads.fit} ${fit}`}>{fit}</span>
                <span class="who"><strong>{name}</strong> {role}</span>
                <span class="sig">{signal}</span>
                {i === 0 && <span class="evidence">{t.how.leads.evidence}</span>}
              </li>
            ))}
          </ol>
        </div>
        <div class="frag frag-msg" data-ui data-stage="3" aria-hidden="true">
          <p class="frag-title">{t.how.message.to}</p>
          <p class="frag-body">{t.how.message.body}</p>
          <p class="frag-status">{t.how.message.status}</p>
          <p class="frag-actions"><span class="frag-button">{t.how.message.approve}</span><span class="frag-button ghost">{t.how.message.edit}</span></p>
        </div>
        <p class="sample-note">{t.how.sample}</p>
      </div>
      <div class="how-control">
        <span class="how-track" aria-hidden="true"><span class="how-fill"></span></span>
        <input id="how-range" type="range" min="0" max="3" step="1" value="0" aria-label={t.how.stagesLabel}
          aria-valuetext={t.how.stages[0].name} data-names={JSON.stringify(t.how.stages.map((s) => s.name))} />
        <ol class="how-names">
          {t.how.stages.map((s, i) => <li data-stage={i}><button type="button" data-go={i}>{s.name}</button></li>)}
        </ol>
      </div>
    </section>

    <section class="blink g-blue" id="blink" data-ground="blue" aria-labelledby="blink-heading">
      <input class="blink-input sr-only" type="checkbox" id="blink-toggle" role="switch" aria-label={t.blink.switchLabel} />
      <div class="blink-head">
        <h2 id="blink-heading" class="h-lead">{t.blink.heading}</h2>
        <p>{t.blink.text}</p>
        <p class="blink-hint">{t.blink.hint}</p>
      </div>
      <div class="market" data-ui aria-label={t.blink.sample}>
        {stars.map((s) => <span class="star" style={`--x:${s.x}%;--y:${s.y}%;--r:${s.r}`}></span>)}
        {movers.map((m, i) => (
          <div class="mover" style={`--x:${m.x}%;--y:${m.y}%;--dx:${m.dx};--dy:${m.dy}`} data-i={i}>
            <button type="button" class="mover-dot" aria-expanded="false" aria-controls={`mover-${i}`}>
              <span class="mover-name">{m.name}</span>
              <span class="mover-signal">{m.signal}</span>
            </button>
            <div class="mover-card" id={`mover-${i}`} role="group" aria-label={m.name}>
              <p class="mover-card-name">{m.name}</p>
              <p>{m.signal}</p>
              <p class="mover-card-meta"><span>{t.blink.source}: {m.source}</span><span>{t.blink.fit} {m.fit}</span></p>
            </div>
          </div>
        ))}
      </div>
      <label class="big-switch" for="blink-toggle" data-ui>
        <span class="big-switch-track"><span class="big-switch-thumb"></span></span>
        <span class="big-switch-days"><span class="day-mon">{t.blink.monday}</span><span class="day-thu">{t.blink.thursday}</span></span>
      </label>
      <p class="sample-note blink-sample">{t.blink.sample}</p>
    </section>

    <section class="compose" id="messages" data-ground="print" aria-labelledby="compose-heading">
      <h2 id="compose-heading" class="h-head compose-heading g-plate">{t.compose.heading}</h2>
      <div class="compose-out g-print">
        <article class="mail" data-ui aria-live="polite">
          <p class="mail-to"><span>{t.compose.to}</span> Camille Roux, Atelier Roux</p>
          {LOCALES.map((l) => channels.map((c) => (
            <div class="mail-variant" data-lang={l} data-channel={c}>
              {c === "email" && <p class="mail-subject"><span>{t.compose.subject}</span> {SAMPLE_MESSAGES[l].subject}</p>}
              <p class="mail-body" lang={l}>{SAMPLE_MESSAGES[l][c]}</p>
            </div>
          )))}
          <div class="mail-foot">
            <p class="mail-status">
              <span class="st-review">{t.compose.statusReview}</span>
              <span class="st-auto">{t.compose.statusAuto}</span>
              <span class="st-manual">{t.compose.statusManual}</span>
            </p>
            <span class="mail-window" aria-hidden="true"></span>
          </div>
        </article>
      </div>
      <div class="compose-col g-plate">
        <form class="compose-form" onsubmit="return false">
          <div class="cap reveal">
            <h3 class="h-lead">{t.compose.blocks[0].title}</h3>
            <p>{t.compose.blocks[0].text}</p>
            <fieldset class="seg"><legend class="sr-only">{t.compose.channelLabel}</legend>
              <label><input type="radio" name="channel" value="linkedin" checked /><span>LinkedIn</span></label>
              <label><input type="radio" name="channel" value="email" /><span>Email</span></label>
            </fieldset>
          </div>
          <div class="cap reveal">
            <h3 class="h-lead">{t.compose.blocks[1].title}</h3>
            <p>{t.compose.blocks[1].text}</p>
            <fieldset class="seg seg-wrap"><legend class="sr-only">{t.compose.languageLabel}</legend>
              {LOCALES.map((l) => <label><input type="radio" name="lang" value={l} checked={l === locale} /><span lang={l}>{LOCALE_NAMES[l]}</span></label>)}
            </fieldset>
          </div>
          <div class="cap reveal">
            <h3 class="h-lead">{t.compose.blocks[2].title}</h3>
            <p>{t.compose.blocks[2].text}</p>
            <fieldset class="seg"><legend class="sr-only">{t.compose.modeLabel}</legend>
              <label><input type="radio" name="mode" value="auto" checked /><span>{t.compose.modeAuto}</span></label>
              <label><input type="radio" name="mode" value="manual" /><span>{t.compose.modeManual}</span></label>
            </fieldset>
          </div>
          <div class="cap reveal">
            <h3 class="h-lead">{t.compose.blocks[3].title}</h3>
            <p>{t.compose.blocks[3].text}</p>
            <label class="approve"><input type="checkbox" name="approved" /><span class="approve-off">{t.compose.approve}</span><span class="approve-on">{t.compose.approved} · {t.compose.undo}</span></label>
          </div>
        </form>
      </div>
    </section>

    <section class="pricing g-print" id="pricing" data-ground="print" aria-labelledby="pricing-heading">
      <div class="ticket reveal" data-ui>
        <div class="ticket-main">
          <h2 id="pricing-heading" class="h-head">{t.pricing.heading}</h2>
          <fieldset class="seg seg-ticket"><legend class="sr-only">{t.pricing.planLabel}</legend>
            <label><input type="radio" name="plan" value="own" checked /><span>{t.pricing.own}</span></label>
            <label><input type="radio" name="plan" value="all" /><span>{t.pricing.all}</span></label>
          </fieldset>
          <ul class="ticket-lines plan-own">{t.pricing.ownLines.map((l) => <li>{l}</li>)}</ul>
          <ul class="ticket-lines plan-all">{t.pricing.allLines.map((l) => <li>{l}</li>)}</ul>
        </div>
        <div class="ticket-stub">
          <p class="price">
            <span class="plan-own">19,99&nbsp;€</span><span class="plan-all">49,99&nbsp;€</span>
            <small>{t.pricing.perMonth}</small>
          </p>
          <a class="btn btn-paper ticket-cta plan-own" href={`${SIGNUP_URL}?plan=own`}>{t.pricing.cta} · {t.pricing.own}</a>
          <a class="btn btn-paper ticket-cta plan-all" href={`${SIGNUP_URL}?plan=all`}>{t.pricing.cta} · {t.pricing.all}</a>
          <span class="notch notch-top" aria-hidden="true"></span>
          <span class="notch notch-bottom" aria-hidden="true"></span>
          <span class="perforation" aria-hidden="true">{Array.from({ length: 14 }, () => <i></i>)}</span>
        </div>
      </div>
      <p class="self-host reveal">{t.pricing.selfHost} <a href={REPO_URL}>{t.pricing.selfHostLink}</a></p>
    </section>

    <section class="faq g-plate" id="faq" data-ground="plate" aria-labelledby="faq-heading">
      <div class="faq-head">
        <h2 id="faq-heading" class="h-head">{t.faq.heading}</h2>
        <figure class="faq-photo reveal">
          <img src="/img/astrograph.webp" width="1600" height="1155" alt="The 13-inch astrograph at Lowell Observatory" loading="lazy" />
        </figure>
      </div>
      <div class="faq-list">
        {t.faq.items.map(([q, a], i) => (
          <details name="faq" class="reveal" open={i === 0}>
            <summary>{q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="foot g-print" data-ground="print">
    <div class="foot-sky"><img class="foot-pluto" src="/img/pluto.webp" width="1600" height="1600" alt="Pluto photographed by New Horizons, July 2015" loading="lazy" /></div>
    <div class="foot-top">
      <Logo />
      <div class="foot-notes">{t.footer.notes.map((n) => <p>{n}</p>)}</div>
      <a class="foot-up" href="#top">{t.footer.top}</a>
    </div>
    <p class="foot-display"><a href={REPO_URL}><span>{t.footer.display.slice(0, t.footer.display.lastIndexOf("/"))}</span><span>{t.footer.display.slice(t.footer.display.lastIndexOf("/"))}</span></a></p>
    <div class="foot-meta">
      <p><a href={REPO_URL}>GitHub</a> <a href={LICENSE_URL}>{t.footer.license}</a></p>
      <p class="credits">{t.footer.picturesLabel}: {pictureCredits.map((c, i) => (
        <>{i > 0 && "; "}<a href={c.page}>“{c.title}”</a>, {c.creator}, <a href={c.licenseUrl}>{c.license}</a></>
      ))}.</p>
      <p>© {t.footer.year} Mathis Sportiello</p>
    </div>
  </footer>
  <script src="../scripts/main.ts"></script>
</Base>
