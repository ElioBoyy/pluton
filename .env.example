# SQLite file (relative to the repo root)
DATABASE_URL=file:./data/pluton.db
SERVER_PORT=8787

# Phase 1+
# Claude access for the research agent: "subscription" uses your Claude Code login (personal use),
# "api_key" uses ANTHROPIC_API_KEY below.
PLUTON_AGENT_BACKEND=subscription
ANTHROPIC_API_KEY=

# Dev only: replay a canned Brain instead of calling Claude (UI work without credits)
PLUTON_SIMULATE_AGENT=0
