# Technical settings only. API keys and the Claude access mode are set in the app:
# Settings → API keys (stored encrypted in the local database).

# SQLite file (relative to the repo root). Hosted (PLUTON_HOSTED=1): Postgres, postgres://user:password@host:5432/db
DATABASE_URL=file:./data/pluton.db
SERVER_PORT=8787

# Dev only: replay a canned Brain instead of calling Claude (UI work without credits)
PLUTON_SIMULATE_AGENT=0

# Self-hosted only: look up small businesses' map listing (OpenStreetMap) for a phone, a website and an
# email, from their SIREN. Off by default; ignored when PLUTON_HOSTED=1 (Nominatim's free service isn't
# meant for a hosted app's traffic).
PLUTON_MAP_LISTINGS=0

# Hosted app only (self-hosted installs leave these out: no sign-in, no payment).
# PLUTON_HOSTED=1 makes the app ask people to sign in with Google or Apple, then subscribe, before anything else.
PLUTON_HOSTED=0
APP_URL=http://localhost:5173
# Google: OAuth client (Web application), redirect URI <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID, Team ID, and a Sign in with Apple key (.p8 contents, line breaks as \n).
# Return URL <APP_URL>/api/auth/apple/callback (Apple needs https and a real domain).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Stripe: one recurring price per plan, and a webhook to <APP_URL>/api/stripe/webhook
# listening to checkout.session.completed and customer.subscription.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BYO=
STRIPE_PRICE_ALL=
# The yearly prices (1-year commitment), and LinkedIn sending accounts billed per account, monthly and yearly.
STRIPE_PRICE_BYO_YEAR=
STRIPE_PRICE_ALL_YEAR=
STRIPE_PRICE_LINKEDIN=
STRIPE_PRICE_LINKEDIN_YEAR=
# Stripe's customer portal (card, invoices, cancelling). All of the above: pnpm --filter @pluton/server stripe:setup
STRIPE_PORTAL_CONFIGURATION=
# Resend: the app's own emails (the digest), from an address on a domain verified in Resend,
# e.g. Pluton <hello@plut0n.com>. Without them the digest uses the SMTP from Settings → API keys.
# Outreach emails always leave from that SMTP, never through Resend.
RESEND_API_KEY=
EMAIL_FROM=
# In a container: the address the server listens on (0.0.0.0). Left out, it answers this machine only.
SERVER_HOST=

# Hosted only: keys Pluton pays for, used by a paying workspace that saved none of its own.
# Claude on "All included"; the data sources on both plans. Spend counts against the plan's credits.
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_HUNTER_API_KEY=
PLATFORM_APIFY_TOKEN=
PLATFORM_THEIRSTACK_API_KEY=
# Credits each plan includes a month (1 $ of usage at API prices = 100 credits).
PLATFORM_QUOTA_CREDITS_ALL=2000
PLATFORM_QUOTA_CREDITS_BYO=600
# Fixed rate euro prices (Hunter's plans) are turned into dollars at.
PLUTON_USD_PER_EUR=1.12
# Hosted: most one account may ask at once, over all its workspaces, whatever its credits.
PLUTON_LIMIT_CONCURRENT_RUNS=2
PLUTON_LIMIT_JOBS_PER_HOUR=60
PLUTON_LIMIT_JOBS_PER_DAY=300
# Hosted: caps on Pluton's own keys across every account together, in US dollars of the ledger's
# cost; reached, that key pauses for everyone until the month (UTC) or day (UTC) ends, while
# customers with their own key carry on. Empty or 0: no cap. A fixed-price plan (Hunter,
# TheirStack) wants a monthly cap just under its size; a metered one (Claude, Apify) a daily cap
# high enough to only ever stop a runaway. Any source works: _CLAUDE, _APIFY, _HUNTER, _THEIRSTACK.
PLATFORM_MONTHLY_CAP_USD_HUNTER=
PLATFORM_MONTHLY_CAP_USD_THEIRSTACK=
PLATFORM_DAILY_CAP_USD_CLAUDE=
PLATFORM_DAILY_CAP_USD_APIFY=
# Who hears at 80% and 100% of a cap, by email (through Resend, or the SMTP above). Always logged.
PLUTON_OPERATOR_EMAIL=
